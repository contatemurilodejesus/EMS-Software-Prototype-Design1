{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node backend/src/server/index.ts",
    "test": "node --test \"backend/tests/*.test.ts\"",
    "test:api": "node --test backend/tests/api.test.ts",
    "proof:rls": "node backend/proof/rls.proof.ts",
    "verify:frontend": "node scripts/verify-frontend-api.mjs",
    "db:migrate": "node backend/src/database/postgres/migrate.ts",
    "db:seed": "node backend/src/database/postgres/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mqtt": "^5.16.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
