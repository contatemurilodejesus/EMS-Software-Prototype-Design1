# EnergyMatrix EMS — variáveis de ambiente (protótipo de competição)
# Copie para `.env` e ajuste conforme necessário. Nada aqui é obrigatório para
# rodar a demonstração: sem um `.env`, o backend roda embutido no Vite em /api.

# ---------------------------------------------------------------------------
# Backend embutido no Vite (padrão no Figma Make / vite dev / vite preview)
# ---------------------------------------------------------------------------
# Porta do servidor de desenvolvimento/preview.
PORT=8443
# Habilita a telemetria simulada (store em memória).
EMS_LIVE=true
# Driver de persistência: memory (demonstração) | postgres (produção).
EMS_PERSISTENCE=memory

# ---------------------------------------------------------------------------
# Backend standalone (opcional): `npm run server`
# ---------------------------------------------------------------------------
# Porta do servidor HTTP do backend.
EMS_API_PORT=8787
EMS_API_HOST=0.0.0.0
# Prefixo da API e nivel de log estruturado.
API_PREFIX=/api
LOG_LEVEL=info
# URL do backend externo consumida pelo frontend (deixe vazio para usar /api).
# VITE_EMS_API_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# MQTT (Fase 4) - ingestao de telemetria industrial real
# ---------------------------------------------------------------------------
# Liga/desliga o client MQTT do backend. Desligado por padrao: dev sem broker
# nao pode quebrar a aplicacao (health reporta "disabled").
EMS_MQTT_ENABLED=false
EMS_MQTT_URL=mqtt://localhost:1883
# Credenciais do gateway no broker (obrigatorias com allow_anonymous=false).
#EMS_MQTT_USERNAME=
#EMS_MQTT_PASSWORD=
# Padrao de subscribe (wildcards MQTT).
EMS_MQTT_TOPIC=energy/+/machines/+/telemetry
# Porta do broker no host (usada pelo docker compose).
EMS_MQTT_PORT=1883

# ---------------------------------------------------------------------------
# Docker Compose (Fase 8) - portas publicadas no host
# ---------------------------------------------------------------------------
# Backend (API standalone) e frontend (nginx + proxy /api).
EMS_BACKEND_PORT=8787
EMS_FRONTEND_PORT=8080
# Porta do Postgres no host (5432 local pode estar ocupada por outro banco).
EMS_POSTGRES_PORT=5433
# ---------------------------------------------------------------------------
# Autenticacao e multi-tenancy (secao 7 / 15)
# ---------------------------------------------------------------------------
# Segredos dos tokens. Em PRODUCAO nao existe fallback: o backend sobe sem
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET, por seguranca.
JWT_ACCESS_SECRET=energymatrix-dev-access-secret
JWT_REFRESH_SECRET=energymatrix-dev-refresh-secret
# Expiracoes (P3 e P4) do par de tokens.
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
INVITE_TTL_HOURS=72
# Origens permitidas no navegador (separadas por virgula).
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Rate limiting por categoria (secao 11.1) - maximo por janela
# ---------------------------------------------------------------------------
# AUTH: tentativas de login/convite por minuto (janela de 60s).
EMS_RATE_LIMIT_AUTH_MAX=10
# API GERAL: requisicoes autenticadas por minuto (janela de 60s).
EMS_RATE_LIMIT_API_MAX=300
# TELEMETRIA: leituras ingeridas por 10 segundos.
EMS_RATE_LIMIT_TELEMETRY_MAX=120
# ADMIN: operacoes administrativas por minuto (janela de 60s).
EMS_RATE_LIMIT_ADMIN_MAX=120

# ---------------------------------------------------------------------------
# Bancos de dados (P0: separacao de papéis)
# ---------------------------------------------------------------------------
# DATABASE_URL: papel COMUM da aplicacao (energymatrix_app - NOSUPERUSER
# NOBYPASSRLS). e ele quem faz a RLS valer.
# DATABASE_ADMIN_URL: papel de administracao (energymatrix) usado SOMENTE
# por migrations e seed. Sem definicao, dev local usa a mesma URL.
#DATABASE_URL=postgres://energymatrix_app:energymatrix_app@localhost:5433/energymatrix
#DATABASE_ADMIN_URL=postgres://energymatrix:energymatrix@localhost:5433/energymatrix

# ---------------------------------------------------------------------------
# Limiares analiticos (P1, P2, P5 e P6) - vira configuracao por tenant depois
# ---------------------------------------------------------------------------
# P2: minutos sem telemetria antes de a maquina ficar OFFLINE (D9).
OFFLINE_TIMEOUT_MIN=5
# P1: janela minima de IDLE a jusante para a analise de impacto (D2).
IMPACT_MIN_WINDOW_MIN=10
# P5/P6: janelas "antes" e "depois" da comparacao antes x depois (D11).
BEFORE_WINDOW_HOURS=24
AFTER_WINDOW_HOURS=24
# Habilita /api/demo/* e o simulador (D20).
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Credenciais do seed (SO no seed - nenhuma senha real no Git, secao 6.3)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@energymatrix.demo
SEED_ADMIN_PASSWORD=demo-admin-2026
SEED_ACCOUNTING_EMAIL=financeiro@energymatrix.demo
SEED_ACCOUNTING_PASSWORD=demo-contabil-2026
SEED_EVALUATOR_EMAIL=avaliador@energymatrix.demo
SEED_EVALUATOR_PASSWORD=demo-avaliador-2026
# Tenant B - existe para provar o isolamento entre tenants (secao 18.1).
SEED_TENANT_B_EMAIL=admin@empresa-b.demo
SEED_TENANT_B_PASSWORD=demo-empresa-b-2026
